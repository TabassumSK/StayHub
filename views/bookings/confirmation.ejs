<style>
  .booking-confirmation {
    max-width: 800px;
    margin: 0 auto;
    padding: clamp(2rem, 6vw, 4rem) 0;
    color: #24343a;
  }

  .confirmation-card {
    padding: clamp(1.5rem, 5vw, 3rem);
    border: 1px solid #d7e1df;
    border-radius: 1.1rem;
    background: #f2f5f4;
    box-shadow: 0 12px 32px rgb(31 41 51 / 8%);
  }

  .confirmation-icon {
    display: grid;
    width: 3.5rem;
    height: 3.5rem;
    margin-bottom: 1.25rem;
    place-items: center;
    border-radius: 50%;
    background: #fbf0d9;
    color: #956a20;
  }

  .confirmation-icon i {
    font-size: 1.45rem;
  }

  .confirmation-card h1 {
    margin-bottom: 0.75rem;
    font-size: clamp(1.7rem, 4vw, 2.4rem);
    font-weight: 800;
    letter-spacing: -0.04em;
  }

  .confirmation-message {
    margin-bottom: 1.5rem;
    color: #52616b;
    line-height: 1.7;
  }

  .confirmation-details {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.8rem;
    margin: 0 0 1.5rem;
  }

  .confirmation-detail {
    padding: 0.9rem 1rem;
    border: 1px solid #d7e1df;
    border-radius: 0.75rem;
    background: #fff;
  }

  .confirmation-detail dt {
    margin-bottom: 0.25rem;
    color: #687681;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .confirmation-detail dd {
    margin: 0;
    font-weight: 750;
    overflow-wrap: anywhere;
  }

  .receipt-header {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }

  .receipt-reference {
    margin: 0;
    color: #687681;
    font-size: 0.85rem;
    text-align: right;
  }

  .receipt-lines {
    margin: 0 0 1.5rem;
    padding: 0;
    border-top: 1px solid #d7e1df;
    list-style: none;
  }

  .receipt-line {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.85rem 0;
    border-bottom: 1px solid #d7e1df;
  }

  .receipt-line span {
    color: #52616b;
  }

  .receipt-line strong {
    text-align: right;
  }

  .receipt-total {
    font-size: 1.08rem;
    font-weight: 800;
  }

  .confirmation-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .confirmation-actions .btn {
    padding: 0.7rem 1rem;
    border-radius: 0.65rem;
  }

  .confirmation-actions .btn-primary {
    border-color: #0d6e6e;
    background: #0d6e6e;
  }

  @media print {
    .confirmation-card {
      border: 0;
      background: #fff;
      box-shadow: none;
    }

    .confirmation-actions {
      display: none;
    }
  }

  @media (max-width: 540px) {
    .confirmation-details {
      grid-template-columns: 1fr;
    }
  }
</style>

<% layout('/layouts/boilerplate') %>

<main class="booking-confirmation">
  <section class="confirmation-card">
    <div class="receipt-header">
      <div>
        <div class="confirmation-icon" aria-hidden="true">
          <i class="fa-solid fa-hourglass-half"></i>
        </div>
        <p class="booking-eyebrow">Booking request saved</p>
        <h1>Payment is still pending</h1>
      </div>
      <p class="receipt-reference">
        Receipt preview<br>
        <strong>SH-<%= booking._id.toString().slice(-8).toUpperCase() %></strong><br>
        <%= booking.createdAt.toLocaleDateString("en-IN", { day: "numeric", month: "short", year: "numeric", timeZone: "UTC" }) %>
      </p>
    </div>
    <p class="confirmation-message">
      Your selected payment method and trip details have been saved for <strong><%= booking.listing.title %></strong>.
      This demo does not collect payment, so this receipt is not proof of payment or a confirmed reservation.
    </p>

    <% const nights = (booking.checkOut.getTime() - booking.checkIn.getTime()) / 86400000; %>
    <ul class="receipt-lines" aria-label="Receipt price details">
      <li class="receipt-line">
        <span>Accommodation (<%= nights %> <%= nights === 1 ? 'night' : 'nights' %> × ₹ <%= booking.nightlyPrice.toLocaleString("en-IN") %>)</span>
        <strong>₹ <%= booking.totalPrice.toLocaleString("en-IN") %></strong>
      </li>
      <li class="receipt-line receipt-total">
        <span>Estimated total</span>
        <strong>₹ <%= booking.totalPrice.toLocaleString("en-IN") %></strong>
      </li>
    </ul>

    <dl class="confirmation-details">
      <div class="confirmation-detail">
        <dt>Listing</dt>
        <dd><%= booking.listing.title %></dd>
      </div>
      <div class="confirmation-detail">
        <dt>Location</dt>
        <dd><%= booking.listing.location %><%= booking.listing.country ? `, ${booking.listing.country}` : '' %></dd>
      </div>
      <div class="confirmation-detail">
        <dt>Check-in</dt>
        <dd><%= booking.checkIn.toLocaleDateString("en-IN", { day: "numeric", month: "short", year: "numeric", timeZone: "UTC" }) %></dd>
      </div>
      <div class="confirmation-detail">
        <dt>Check-out</dt>
        <dd><%= booking.checkOut.toLocaleDateString("en-IN", { day: "numeric", month: "short", year: "numeric", timeZone: "UTC" }) %></dd>
      </div>
      <div class="confirmation-detail">
        <dt>Guests</dt>
        <dd><%= booking.guests %></dd>
      </div>
      <div class="confirmation-detail">
        <dt>Payment method selected</dt>
        <dd><%= paymentMethods.find(method => method.value === booking.paymentMethod).label %></dd>
      </div>
      <div class="confirmation-detail">
        <dt>Booking status</dt>
        <dd>Awaiting payment</dd>
      </div>
    </dl>

    <div class="confirmation-actions">
      <button type="button" class="btn btn-outline-dark" onclick="window.print()">Print receipt</button>
      <a href="/listings/<%= booking.listing._id %>" class="btn btn-primary">Back to this place</a>
      <a href="/listings" class="btn btn-outline-dark">Explore other stays</a>
    </div>
  </section>
</main>
