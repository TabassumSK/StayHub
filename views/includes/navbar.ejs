<nav class="navbar navbar-expand-lg stayhub-navbar sticky-top">
  <div class="container-fluid stayhub-navbar-inner">
    <a class="navbar-brand stayhub-brand" href="/listings" aria-label="StayHub home">
      <span class="stayhub-brand-mark"><i class="fa-solid fa-compass" aria-hidden="true"></i></span>
      <span class="stayhub-brand-name">StayHub</span>
    </a>

    <button
      class="navbar-toggler"
      type="button"
      data-bs-toggle="collapse"
      data-bs-target="#navbarNavAltMarkup"
      aria-controls="navbarNavAltMarkup"
      aria-expanded="false"
      aria-label="Toggle navigation">
      <span class="navbar-toggler-icon"></span>
    </button>

    <div class="collapse navbar-collapse stayhub-navbar-content" id="navbarNavAltMarkup">
      <form class="stayhub-search" action="/listings#listings" method="get" role="search">
        <label class="visually-hidden" for="stayhub-search-input">Search stays</label>
        <i class="fa-solid fa-magnifying-glass stayhub-search-icon" aria-hidden="true"></i>
        <input
          id="stayhub-search-input"
          class="form-control stayhub-search-input"
          type="search"
          name="q"
          value="<%= typeof q !== 'undefined' ? q : '' %>"
          placeholder="Search destinations or stays"
          autocomplete="off">
        <button class="btn stayhub-search-button" type="submit">Search</button>
      </form>

      <div class="stayhub-nav-actions">
        <a class="stayhub-host-link" href="/listings/new">
          <i class="fa-solid fa-house-chimney" aria-hidden="true"></i>
          <span>Become a host</span>
        </a>

        <div class="dropdown">
          <button
            class="btn stayhub-profile-button"
            type="button"
            id="profileDropdown"
            data-bs-toggle="dropdown"
            aria-expanded="false"
            aria-label="Open account menu">
            <i class="fa-regular fa-user" aria-hidden="true"></i>
            <% if (currUser) { %>
              <span class="stayhub-profile-name"><%= currUser.username %></span>
            <% } else { %>
              <span class="stayhub-profile-name">Account</span>
            <% } %>
            <i class="fa-solid fa-chevron-down stayhub-profile-chevron" aria-hidden="true"></i>
          </button>

          <ul class="dropdown-menu dropdown-menu-end stayhub-profile-menu" aria-labelledby="profileDropdown">
            <% if (currUser) { %>
              <li class="stayhub-menu-greeting">Signed in as <strong><%= currUser.username %></strong></li>
              <li><hr class="dropdown-divider"></li>
              <li>
                <a class="dropdown-item" href="/logout">
                  <i class="fa-solid fa-arrow-right-from-bracket" aria-hidden="true"></i>Log out
                </a>
              </li>
            <% } else { %>
              <li>
                <a class="dropdown-item" href="/login">
                  <i class="fa-solid fa-arrow-right-to-bracket" aria-hidden="true"></i>Log in
                </a>
              </li>
              <li>
                <a class="dropdown-item" href="/signup">
                  <i class="fa-solid fa-user-plus" aria-hidden="true"></i>Create an account
                </a>
              </li>
            <% } %>
            <li><hr class="dropdown-divider"></li>
            <li>
              <a class="dropdown-item" href="/listings/new">
                <i class="fa-solid fa-house-chimney" aria-hidden="true"></i>List your place
              </a>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </div>
</nav>
