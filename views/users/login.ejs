<style>
  .auth-card {
    width: min(100%, 460px);
    padding: clamp(1.5rem, 5vw, 2.5rem);
  }
</style>

<% layout("/layouts/boilerplate") %>

<main class="auth-page d-flex justify-content-center align-items-center">
  <section class="auth-card">
    <p class="listing-eyebrow text-center">Welcome back</p>
    <h1 class="auth-heading text-center">Log in to StayHub</h1>
    <p class="auth-intro text-center">Sign in to continue planning your next stay.</p>

    <form action="/login" method="POST" class="needs-validation" novalidate>
      <div class="mb-3">
        <label for="username" class="form-label">Username</label>
        <input
          name="username"
          id="username"
          type="text"
          class="form-control rounded-3"
          required
        />
        <div class="valid-feedback">Username looks good</div>
      </div>

      <div class="mb-3">
        <label for="password" class="form-label">Password</label>
        <input
          name="password"
          id="password"
          type="password"
          class="form-control rounded-3"
          required
        />
      </div>

      <div class="d-grid">
        <button class="btn btn-primary">Log in</button>
      </div>

      <p class="text-center mt-3 mb-0">
        New to StayHub?
        <a href="/signup" class="text-decoration-none fw-semibold">Create an account</a>
      </p>

    </form>
  </section>
</main>
